{
  "name": "school management application",
  "version": "1.0.0",
  "description": "An application for school students, that helps learning using AI",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "rag:ingest": "node src/modules/rag/ingest/ingestAllBooks.js",
    "migrate": "sequelize-cli --config config/config.cjs db:migrate",
    "migrate:undo": "sequelize-cli --config config/config.cjs db:migrate:undo",
    "seed": "sequelize-cli --config config/config.cjs db:seed:all",
    "seed:undo": "sequelize-cli --config config/config.cjs db:seed:undo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aravindh99/kiddo-backend.git"
  },
  "keywords": [
    "school"
  ],
  "author": "https://github.com/aravindh99",
  "license": "ISC",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@google-cloud/storage": "^7.21.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^1.40.0",
    "axios": "^1.18.1",
    "chromadb": "^3.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "puppeteer-core": "^25.4.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.3.4"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10"
  }
}
